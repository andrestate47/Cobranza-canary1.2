generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-arm64-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                      String                  @id @default(cuid())
  email                   String                  @unique
  password                String
  firstName               String?
  lastName                String?
  name                    String?
  role                    UserRole                @default(COBRADOR)
  isActive                Boolean                 @default(true) @map("activo")
  createdAt               DateTime                @default(now())
  updatedAt               DateTime                @updatedAt
  address                 String?
  ciudad                  String?
  documentoIdentificacion String?                 @map("documento_identificacion")
  lastLogin               DateTime?
  mapLink                 String?                 @map("map_link")
  numeroRuta              String?                 @map("numero_ruta")
  pais                    String?
  phone                   String?
  phoneReferencial        String?                 @map("phone_referencial")
  profilePhoto            String?                 @map("profile_photo")
  referenciaFamiliar      String?                 @map("referencia_familiar")
  referenciaTrabajo       String?                 @map("referencia_trabajo")
  rutaId                  String?                 @map("ruta_id")
  supervisorId            String?                 @map("supervisor_id")
  timeLimit               Int?
  ubicacion               String?
  accounts                Account[]
  cierresDia              CierreDia[]
  configuracionSueldo     ConfiguracionSueldo?
  dispositivos            DispositivoAutorizado[]
  gastos                  Gasto[]
  movimientosAsignados    MovimientoCajaChica[]   @relation("AsignadorCajaChica")
  movimientosCajaChica    MovimientoCajaChica[]   @relation("CobradorCajaChica")
  pagos                   Pago[]
  pagosSueldoCobrador     PagoSueldo[]            @relation("CobradorPagos")
  pagosSueldoPagador      PagoSueldo[]            @relation("PagadorPagos")
  prestamos               Prestamo[]
  sessions                Session[]
  participacionesSusu     SusuParticipante[]
  sususCreados            Susu[]
  transferencias          Transferencia[]
  permissions             UserPermission[]
  timeUsage               UserTimeUsage[]
  ruta                    Ruta?                   @relation("UsuarioRuta", fields: [rutaId], references: [id])
  supervisor              User?                   @relation("UserSupervisor", fields: [supervisorId], references: [id])
  supervisados            User[]                  @relation("UserSupervisor")
  visitasCliente          VisitaCliente[]
  ordenesRuta             OrdenRutaDia[]

  @@map("users")
}

model UserPermission {
  id         String     @id @default(cuid())
  userId     String     @map("user_id")
  permission Permission
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, permission])
  @@map("user_permissions")
}

model UserTimeUsage {
  id           String   @id @default(cuid())
  userId       String   @map("user_id")
  date         DateTime @db.Date
  minutes      Int      @default(0)
  lastActivity DateTime @default(now())
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
  @@map("user_time_usage")
}

model Account {
  id                String  @id @default(cuid())
  userId            String  @map("user_id")
  type              String
  provider          String
  providerAccountId String  @map("provider_account_id")
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique @map("session_token")
  userId       String   @map("user_id")
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@unique([identifier, token])
  @@map("verificationtokens")
}

model Cliente {
  id                    String          @id @default(cuid())
  nombre                String
  apellido              String
  telefono              String?
  foto                  String?
  activo                Boolean         @default(true)
  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @updatedAt
  ciudad                String?
  codigoCliente         String          @unique
  direccionCliente      String
  direccionCobro        String?
  documento             String          @unique
  fotoDocumento         String?
  mapLink               String?         @map("map_link")
  numeroRuta            String?         @map("numero_ruta")
  pais                  String?
  referenciasPersonales String?
  rutaId                String?         @map("ruta_id")
  ubicacion             String?
  ultimaVisita          DateTime?
  ruta                  Ruta?           @relation("ClienteRuta", fields: [rutaId], references: [id])
  prestamos             Prestamo[]
  visitas               VisitaCliente[]

  @@index([rutaId])
  @@index([activo])
  @@map("clientes")
}

model Prestamo {
  id               String          @id @default(cuid())
  clienteId        String          @map("cliente_id")
  userId           String          @map("user_id")
  monto            Decimal         @db.Decimal(10, 2)
  interes          Decimal         @db.Decimal(5, 2)
  tipoPago         TipoPago        @default(DIARIO)
  cuotas           Int
  valorCuota       Decimal         @db.Decimal(10, 2)
  fechaInicio      DateTime
  fechaFin         DateTime
  estado           EstadoPrestamo  @default(ACTIVO)
  observaciones    String?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  diasGracia       Int             @default(0)
  interesTotal     Decimal?        @db.Decimal(10, 2)
  microseguroTipo  TipoMicroseguro @default(NINGUNO) @map("microseguro_tipo")
  microseguroTotal Decimal         @default(0) @map("microseguro_total") @db.Decimal(10, 2)
  microseguroValor Decimal         @default(0) @map("microseguro_valor") @db.Decimal(10, 2)
  moraCredito      Decimal         @default(0) @db.Decimal(5, 2)
  tipoCredito             TipoCredito     @default(EFECTIVO)
  fechaFinManual          DateTime?       @map("fecha_fin_manual")
  diasTranscurridosManual Int?            @map("dias_transcurridos_manual")
  fechaProximoPagoManual  DateTime?       @map("fecha_proximo_pago_manual")
  cuotasPagadasManual     Decimal?        @map("cuotas_pagadas_manual") @db.Decimal(10, 2)
  cuotasAtrasadasManual   Decimal?        @map("cuotas_atrasadas_manual") @db.Decimal(10, 2)
  cuotasPendientesManual  Decimal?        @map("cuotas_pendientes_manual") @db.Decimal(10, 2)
  diasVencidosManual      Int?            @map("dias_vencidos_manual")
  valorEnAtrasoManual     Decimal?        @map("valor_en_atraso_manual") @db.Decimal(10, 2)
  renovadoDeId            String?         @map("renovado_de_id")
  datosRefinanciamiento   Json?           @map("datos_refinanciamiento")
  pagos                   Pago[]
  cliente          Cliente         @relation(fields: [clienteId], references: [id])
  usuario          User            @relation(fields: [userId], references: [id])
  transferencias   Transferencia[]

  @@index([clienteId])
  @@index([userId])
  @@index([estado])
  @@index([fechaInicio])
  @@index([fechaFin])
  @@index([estado, clienteId])
  @@index([userId, estado])
  @@index([createdAt, fechaFin])
  @@map("prestamos")
}

model Pago {
  id            String     @id @default(cuid())
  prestamoId    String     @map("prestamo_id")
  userId        String     @map("user_id")
  monto         Decimal    @db.Decimal(10, 2)
  fecha         DateTime   @default(now())
  observaciones String?
  modificado      Boolean    @default(false)
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt
  metodoPago      MetodoPago @default(EFECTIVO) @map("metodo_pago")
  fotoComprobante String?    @map("foto_comprobante")
  fotoMiniatura   String?    @map("foto_miniatura")
  devolucionSeguro Decimal?  @default(0) @map("devolucion_seguro")
  prestamo        Prestamo   @relation(fields: [prestamoId], references: [id], onDelete: Cascade)
  usuario       User       @relation(fields: [userId], references: [id])

  @@index([prestamoId])
  @@index([userId])
  @@index([fecha])
  @@index([createdAt])
  @@index([prestamoId, fecha])
  @@index([userId, fecha])
  @@map("pagos")
}

model Gasto {
  id              String   @id @default(cuid())
  userId          String   @map("user_id")
  concepto        String
  monto           Decimal  @db.Decimal(10, 2)
  fecha           DateTime @default(now())
  observaciones   String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  fotoComprobante String?  @map("foto_comprobante")
  usuario         User     @relation(fields: [userId], references: [id])

  @@index([fecha])
  @@index([userId, fecha])
  @@map("gastos")
}

model CierreDia {
  id            String   @id @default(cuid())
  userId        String   @map("user_id")
  fecha         DateTime
  totalCobrado  Decimal  @db.Decimal(12, 2)
  totalPrestado Decimal  @db.Decimal(12, 2)
  totalGastos   Decimal  @db.Decimal(12, 2)
  saldoEfectivo Decimal  @db.Decimal(12, 2)
  observaciones String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  usuario       User     @relation(fields: [userId], references: [id])

  @@unique([userId, fecha])
  @@index([fecha])
  @@map("cierres_dia")
}

model Transferencia {
  id              String   @id @default(cuid())
  prestamoId      String   @map("prestamo_id")
  userId          String   @map("user_id")
  monto           Decimal  @db.Decimal(10, 2)
  banco           String?
  referencia      String?
  fotoComprobante String
  observaciones   String?
  fecha           DateTime @default(now())
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  prestamo        Prestamo @relation(fields: [prestamoId], references: [id], onDelete: Cascade)
  usuario         User     @relation(fields: [userId], references: [id])

  @@map("transferencias")
}

model ConfiguracionSueldo {
  id                     String       @id @default(cuid())
  userId                 String       @unique @map("user_id")
  salarioBase            Decimal      @default(0) @db.Decimal(10, 2)
  comisionPorCobro       Decimal      @default(0) @db.Decimal(5, 2)
  limitePorcentajeAvance Int          @default(50)
  montoMinimoAvance      Decimal      @default(0) @db.Decimal(10, 2)
  activo                 Boolean      @default(true)
  createdAt              DateTime     @default(now())
  updatedAt              DateTime     @updatedAt
  usuario                User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  pagosSueldo            PagoSueldo[]

  @@map("configuraciones_sueldo")
}

model PagoSueldo {
  id              String               @id @default(cuid())
  cobradorId      String               @map("cobrador_id")
  pagadorId       String               @map("pagador_id")
  configuracionId String?              @map("configuracion_id")
  tipo            TipoPagoSueldo       @default(SUELDO)
  periodo         String?
  montoBase       Decimal              @db.Decimal(10, 2)
  montoComisiones Decimal              @default(0) @db.Decimal(10, 2)
  montoTotal      Decimal              @db.Decimal(10, 2)
  montoAvances    Decimal              @default(0) @db.Decimal(10, 2)
  montoFinal      Decimal              @db.Decimal(10, 2)
  estado          EstadoPagoSueldo     @default(PENDIENTE)
  observaciones   String?
  fechaPago       DateTime?
  metodoPago      String?
  comprobante     String?
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt
  cobrador        User                 @relation("CobradorPagos", fields: [cobradorId], references: [id])
  configuracion   ConfiguracionSueldo? @relation(fields: [configuracionId], references: [id])
  pagador         User                 @relation("PagadorPagos", fields: [pagadorId], references: [id])

  @@map("pagos_sueldo")
}

model VisitaCliente {
  id            String     @id @default(cuid())
  clienteId     String     @map("cliente_id")
  userId        String     @map("user_id")
  fecha         DateTime   @default(now())
  tipo          TipoVisita @default(COBRO)
  resultado     String?
  observaciones String?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  cliente       Cliente    @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  usuario       User       @relation(fields: [userId], references: [id])

  @@map("visitas_cliente")
}

model DispositivoAutorizado {
  id              String            @id @default(cuid())
  userId          String            @map("user_id")
  deviceId        String            @map("device_id")
  userAgent       String?           @map("user_agent")
  ipAddress       String?           @map("ip_address")
  deviceName      String?           @map("device_name")
  estado          EstadoDispositivo @default(PENDIENTE)
  aprobadoPor     String?           @map("aprobado_por")
  fechaAprobacion DateTime?         @map("fecha_aprobacion")
  ultimoAcceso    DateTime          @default(now()) @map("ultimo_acceso")
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  usuario         User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, deviceId])
  @@map("dispositivos_autorizados")
}

model Ruta {
  id          String    @id @default(cuid())
  numero      String    @unique
  nombre      String
  descripcion String?
  color       String?
  activa      Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  clientes    Cliente[] @relation("ClienteRuta")
  usuarios    User[]    @relation("UsuarioRuta")

  @@map("rutas")
}

model Susu {
  id            String             @id @default(cuid())
  nombre        String
  descripcion   String?
  montoTotal    Decimal            @db.Decimal(10, 2)
  frecuencia    FrecuenciaSusu     @default(SEMANAL)
  fechaInicio   DateTime
  fechaFin      DateTime?
  estado        EstadoSusu         @default(ACTIVO)
  creadorId     String             @map("creador_id")
  observaciones String?
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
  pagos         SusuPago[]
  participantes SusuParticipante[]
  creador       User               @relation(fields: [creadorId], references: [id])

  @@map("susus")
}

model SusuParticipante {
  id              String             @id @default(cuid())
  susuId          String             @map("susu_id")
  userId          String             @map("user_id")
  orden           Int
  montoPorPeriodo Decimal            @db.Decimal(10, 2)
  yaRecibio       Boolean            @default(false)
  fechaRecepcion  DateTime?
  estado          EstadoParticipante @default(ACTIVO)
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
  pagos           SusuPago[]
  susu            Susu               @relation(fields: [susuId], references: [id], onDelete: Cascade)
  usuario         User               @relation(fields: [userId], references: [id])

  @@unique([susuId, userId])
  @@unique([susuId, orden])
  @@map("susu_participantes")
}

model SusuPago {
  id             String           @id @default(cuid())
  susuId         String           @map("susu_id")
  participanteId String           @map("participante_id")
  numeroPeriodo  Int
  monto          Decimal          @db.Decimal(10, 2)
  fechaPago      DateTime         @default(now())
  metodoPago     MetodoPagoSusu   @default(SALDO)
  estado         EstadoPagoSusu   @default(COMPLETADO)
  observaciones  String?
  comprobante    String?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  participante   SusuParticipante @relation(fields: [participanteId], references: [id], onDelete: Cascade)
  susu           Susu             @relation(fields: [susuId], references: [id], onDelete: Cascade)

  @@map("susu_pagos")
}

model RegistroAuditoria {
  id        String      @id @default(cuid())
  usuarioId String      @map("usuario_id")
  accion    TipoAccion
  entidad   TipoEntidad
  entidadId String      @map("entidad_id")
  detalles  String?
  ipAddress String?     @map("ip_address")
  userAgent String?     @map("user_agent")
  fecha     DateTime    @default(now())
  createdAt DateTime    @default(now())

  @@map("registros_auditoria")
}

model MovimientoCajaChica {
  id            String             @id @default(cuid())
  cobradorId    String?            @map("cobrador_id")
  asignadoPorId String?            @map("asignado_por_id")
  tipo          TipoMovimientoCaja @default(ENTREGA)
  monto         Decimal            @db.Decimal(10, 2)
  saldoAnterior Decimal            @db.Decimal(10, 2)
  saldoNuevo    Decimal            @db.Decimal(10, 2)
  fecha         DateTime           @default(now())
  observaciones String?
  descripcion   String?
  comprobante   String?
  estado        EstadoMovimiento   @default(APROBADO)
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
  asignadoPor   User?              @relation("AsignadorCajaChica", fields: [asignadoPorId], references: [id])
  cobrador      User?              @relation("CobradorCajaChica", fields: [cobradorId], references: [id])

  @@index([fecha])
  @@index([cobradorId, fecha])
  @@map("movimientos_caja_chica")
}

model Suscripcion {
  id               String            @id @default(cuid())
  nombreEmpresa    String            @map("nombre_empresa")
  emailContacto    String            @unique @map("email_contacto")
  telefonoContacto String?           @map("telefono_contacto")
  rucEmpresa       String?           @unique @map("ruc_empresa")
  direccion        String?
  plan             PlanSuscripcion   @default(MENSUAL)
  estado           EstadoSuscripcion @default(PRUEBA)
  fechaInicio      DateTime          @default(now()) @map("fecha_inicio")
  fechaVencimiento DateTime          @map("fecha_vencimiento")
  fechaActivacion  DateTime?         @map("fecha_activacion")
  fechaCancelacion DateTime?         @map("fecha_cancelacion")
  observaciones    String?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  pagos            PagoSuscripcion[]

  @@map("suscripciones")
}

model PagoSuscripcion {
  id                String                @id @default(cuid())
  suscripcionId     String                @map("suscripcion_id")
  monto             Decimal               @db.Decimal(10, 2)
  fechaPago         DateTime              @default(now()) @map("fecha_pago")
  metodoPago        MetodoPagoSuscripcion @default(TRANSFERENCIA_BANCARIA) @map("metodo_pago")
  banco             String?
  numeroReferencia  String?               @map("numero_referencia")
  comprobanteUrl    String?               @map("comprobante_url")
  estado            EstadoPago            @default(PENDIENTE)
  periodoInicio     DateTime              @map("periodo_inicio")
  periodoFin        DateTime              @map("periodo_fin")
  observaciones     String?
  verificadoPor     String?               @map("verificado_por")
  fechaVerificacion DateTime?             @map("fecha_verificacion")
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt
  suscripcion       Suscripcion           @relation(fields: [suscripcionId], references: [id], onDelete: Cascade)

  @@map("pagos_suscripcion")
}

model Configuracion {
  id        String   @id @default(cuid())
  moneda    Moneda   @default(USD)
  logoUrl   String?  @map("logo_url")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("configuracion")
}

model OrdenRutaDia {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  fecha     DateTime @db.Date
  orden     String   // Guardará el array serializado: ["prestamoId1", "prestamoId2", ...]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, fecha])
  @@map("orden_ruta_dia")
}

enum UserRole {
  COBRADOR
  ADMINISTRADOR
  SUPERVISOR
}

enum Permission {
  SINCRONIZAR_DATOS
  REGISTRAR_COBROS
  MAPA_CLIENTES
  REGISTRAR_GASTOS
  REGISTRAR_INGRESOS
  VER_REPORTES
  VER_DASHBOARD
  VER_LISTADO_GENERAL
  VER_DETALLES_PRESTAMO
  CREAR_CLIENTES
  EDITAR_CLIENTES
  CREAR_PRESTAMOS
  EDITAR_PRESTAMOS
  ELIMINAR_PRESTAMOS
  REGISTRAR_TRANSFERENCIAS
  VER_TRANSFERENCIAS
  GESTIONAR_USUARIOS
  VER_AUDITORIA
  CONFIGURAR_SISTEMA
  GESTIONAR_PERMISOS
  REALIZAR_CIERRE_DIA
  VER_CIERRES_HISTORICOS
}

enum TipoPago {
  DIARIO
  SEMANAL
  QUINCENAL
  MENSUAL
  LUNES_A_VIERNES
  LUNES_A_SABADO
  CATORCENAL
  FIN_DE_MES
  TRIMESTRAL
  CUATRIMESTRAL
  SEMESTRAL
  ANUAL
}

enum EstadoPrestamo {
  ACTIVO
  CANCELADO
  VENCIDO
  RENOVADO
}

enum TipoCredito {
  EFECTIVO
  TRANSFERENCIA
}

enum TipoMicroseguro {
  NINGUNO
  MONTO_FIJO
  PORCENTAJE
  DEVOLUCION
}

enum TipoPagoSueldo {
  SUELDO
  AVANCE
  COMISION_EXTRA
  DESCUENTO
}

enum EstadoPagoSueldo {
  PENDIENTE
  PAGADO
  CANCELADO
  RECHAZADO
}

enum TipoVisita {
  COBRO
  SEGUIMIENTO
  NEGOCIACION
  ENTREGA_DOCUMENTOS
  VERIFICACION
  OTROS
}

enum FrecuenciaSusu {
  SEMANAL
  QUINCENAL
  MENSUAL
}

enum EstadoSusu {
  ACTIVO
  COMPLETADO
  CANCELADO
}

enum EstadoParticipante {
  ACTIVO
  RETIRADO
  COMPLETADO
}

enum MetodoPagoSusu {
  SALDO
  DEPOSITO
  TRANSFERENCIA
}

enum EstadoPagoSusu {
  COMPLETADO
  RETRASO
  PENDIENTE
}

enum EstadoDispositivo {
  PENDIENTE
  AUTORIZADO
  RECHAZADO
  BLOQUEADO
}

enum EstadoMovimiento {
  PENDIENTE
  APROBADO
  RECHAZADO
}

enum TipoAccion {
  CREAR
  MODIFICAR
  ELIMINAR
}

enum TipoEntidad {
  CLIENTE
  PRESTAMO
  PAGO
  GASTO
  TRANSFERENCIA
  USUARIO
  CONFIGURACION_SUELDO
  PAGO_SUELDO
  SUSU
  DISPOSITIVO
  CAJA_CHICA
}

enum TipoMovimientoCaja {
  ENTREGA
  ENTREGADO
  DEVOLUCION
  DEVUELTO
  AJUSTE
  GASTO
  GASTADO
  APERTURA_CAJA
  EGRESO_GENERAL
  INGRESO
  EGRESO
  PAGO_SUELDO
}

enum PlanSuscripcion {
  MENSUAL
  ANUAL
}

enum EstadoSuscripcion {
  PRUEBA
  ACTIVA
  VENCIDA
  CANCELADA
  SUSPENDIDA
}

enum MetodoPagoSuscripcion {
  TRANSFERENCIA_BANCARIA
  DEPOSITO
  EFECTIVO
}

enum MetodoPago {
  EFECTIVO
  TRANSFERENCIA
  DEPOSITO
}

enum EstadoPago {
  PENDIENTE
  CONFIRMADO
  RECHAZADO
}

